  "author": "Ismail ZAHIR",
  "homepage": "https://github.com/ismailza/ngx-auth-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailza/ngx-auth-client.git"
  },
  "bugs": {
    "url": "https://github.com/ismailza/ngx-auth-client/issues"
  },
  "peerDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false
}

/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* Secondary entry points import the core by its published specifier, the
       same way a consumer does. Mapping them to source keeps type-checking and
       tests honest without a build step in between. */
    "paths": {
      "@ismailza/ngx-auth-client": [
        "./projects/ngx-auth-client/src/public-api.ts"
      ],
      "@ismailza/ngx-auth-client/http": [
        "./projects/ngx-auth-client/http/src/public-api.ts"
      ],
      "@ismailza/ngx-auth-client/keycloak": [
        "./projects/ngx-auth-client/keycloak/src/public-api.ts"
      ],
      "@ismailza/ngx-auth-client/testing": [
        "./projects/ngx-auth-client/testing/src/public-api.ts"
      ]
    },
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ngx-auth-client/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx-auth-client/tsconfig.spec.json"
    }
  ]
}
